# Base URL for the backend API (no trailing /api)
# For local development:
REACT_APP_API_URL=http://localhost:5000/api

# For production (after deploying backend to Render):
# REACT_APP_API_URL=https://your-backend.onrender.com/api

# Google Maps (optional - used for the live tracking map embed)
# Create a free API key at https://console.cloud.google.com/google/maps-apis
# REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
